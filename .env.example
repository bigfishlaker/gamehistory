# Copy to .env.local and fill in. Names only; never commit real values.

# OpenXBL (https://xbl.io) - Xbox profiles, titles, achievements. Free tier: 150 requests/hour.
OPENXBL_API_KEY=

# Steam Web API key (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# PlayStation: NPSSO token for psn-api (from https://ca.account.sony.com/api/v1/ssocookie
# while signed in to playstation.com). Expires after roughly 2 months.
PSN_NPSSO=

# Upstash Redis (Vercel Marketplace). Used for rate limits, the global OpenXBL budget,
# the shared profile cache, short share links and the traffic counter.
# KV_REST_API_URL / KV_REST_API_TOKEN are accepted as aliases. Leave empty locally
# to use the in-memory store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL for absolute Open Graph links (optional)
NEXT_PUBLIC_SITE_URL=

# Traffic counter: random salt for hashing visitor IPs (recommended)
TRAFFIC_SALT=
# Comma-separated IPs whose visits are never counted (e.g. your own)
TRAFFIC_EXCLUDE_IPS=
